PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Optional (recommended): Spotify Web API credentials.
# If missing, backend falls back to Spotify oEmbed (no secrets, less metadata).
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional (recommended): Pinata JWT for real IPFS pinning.
# If missing, backend runs in demo mode and serves pinned JSON via http://localhost:8787/ipfs/<cid>
PINATA_JWT=your_pinata_jwt

# Optional: Pinata gateway (used by frontend if you set VITE_IPFS_GATEWAY accordingly)
PINATA_GATEWAY=https://gateway.pinata.cloud
